LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=300

POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ams_agentic
REPORT_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ams_agentic
REPORT_CATALOG_PATH=reporting/reports.json
REPORT_SQL_DIR=reporting/sql
REPORT_OUTPUT_DIR=output

# Report emails use Amazon SES.
AWS_REGION=us-east-1
SES_SOURCE_EMAIL=
SES_CONFIGURATION_SET=

SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO_HUMAN_REVIEW=

# Switch to Claude/Sonnet later by setting:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
